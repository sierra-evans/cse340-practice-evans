<%- include('../partials/header') %>
<main>
  <div class="course-header">
    <h1><%= course.name %></h1>
    <p class="course-meta">
      <%= course.courseCode %> • <%= course.creditHours %> credits
    </p>
    <p class="course-description">
      <%= course.description %>
    </p>
  </div>

  <div class="sections">
    <div class="sections-header">
      <h2>Available Sections</h2>

      <div class="sort-options">
        <span>Sort by: </span>
        <a href="/catalog/<%= course.slug %>" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a>
        <a href="/catalog/<%= course.slug %>?sort=professor" class="<%= currentSort === 'professor' ? 'active' : '' %>">Professor</a>
        <a href="/catalog/<%= course.slug %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
      </div>
    </div>

    <div class="query-params-sort">
      <% if (queryParams.sort) { %>
        <p>Currently sorted by:
          <strong><%= queryParams.sort.charAt(0).toUpperCase() + queryParams.sort.slice(1) %></strong>
        </p>
      <% } else { %>
        <p>No sorting selected. Using default sort by <strong>Time</strong>.</p>
      <% } %>
    </div>

    <% if (sections.length > 0) { %>
      <div class="section-list">
        <% sections.forEach(section => { %>
          <div class="section-card">
            <div class="section-time"><%= section.time %></div>
            <div class="section-room">Room: <%= section.room %></div>
            <div class="section-professor">
              Instructor:
              <a href="/faculty/<%= section.professorSlug %>">
                <%= section.professor %>
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="no-sections">No sections available for this course at this time.</p>
    <% } %>
  </div>

  <div class="navigation">
    <p><a href="/catalog">&larr; Back to Course Catalog</a></p>
  </div>
</main>
<%- include('../partials/footer') %>